{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-core.json",
  "testRunner": "vitest",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "mutate": ["lib/scoring/**/*.ts", "!lib/scoring/__tests__/**"],
  "reporters": ["clear-text", "html"],
  "htmlReporter": {
    "fileName": ".qa-reports/mutation/index.html"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "timeoutMS": 30000,
  "concurrency": 2
}
