{
  "name": "deep-dive",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "next build --webpack",
    "analyze": "ANALYZE=1 next build --webpack",
    "prebuild": "node --import tsx scripts/check-env.ts --strict",
    "predev": "node --import tsx scripts/check-env.ts --soft",
    "predev:fresh": "node --import tsx scripts/check-env.ts --soft",
    "check:env": "node --import tsx scripts/check-env.ts",
    "check:env:strict": "node --import tsx scripts/check-env.ts --strict",
    "check:vercel-env": "node --import tsx scripts/check-vercel-env.ts",
    "dev": "unset ANTHROPIC_API_KEY ANTHROPIC_BASE_URL 2>/dev/null; next dev",
    "dev:fresh": "unset ANTHROPIC_API_KEY ANTHROPIC_BASE_URL 2>/dev/null; rm -rf .next && next dev",
    "lint": "eslint .",
    "start": "next start",
    "ai:map": "node --import tsx scripts/generate-ai-code-map.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "i18n:check": "node --import tsx scripts/i18n-check.ts",
    "i18n:purity": "node --import tsx scripts/i18n-purity-check.ts",
    "lint:i18n": "node --import tsx scripts/i18n-check.ts && node --import tsx scripts/i18n-purity-check.ts",
    "verify:thesis": "node --env-file=.env.local --import tsx scripts/verify-thesis-data.ts",
    "gdpr:process-deletions": "node --import tsx scripts/process-deletion-requests.ts",
    "gdpr:process-deletions:dry-run": "node --import tsx scripts/process-deletion-requests.ts --dry-run",
    "db:migrate": "node --import tsx scripts/run-migrations.ts",
    "db:migrate:status": "node --import tsx scripts/run-migrations.ts --status",
    "db:migrate:dry-run": "node --import tsx scripts/run-migrations.ts --dry-run",
    "db:migrate:check": "node --import tsx scripts/run-migrations.ts --check",
    "db:generate-types": "node --import tsx scripts/generate-db-types.ts",
    "coaching:v2:metrics": "node --import tsx scripts/coaching-v2-metrics.ts",
    "invites:thesis": "node --import tsx scripts/create-thesis-invite-codes.ts",
    "site:health": "node --import tsx scripts/site-health-check.ts",
    "test:e2e": "node --import tsx scripts/e2e-with-branch.ts",
    "test:e2e:full": "node --import tsx scripts/e2e-with-branch.ts -- --suite=full",
    "test:e2e:llm": "node --import tsx scripts/e2e-with-branch.ts -- --suite=llm",
    "test:e2e:llm:prod": "E2E_USE_GROQ=false node --import tsx scripts/e2e-with-branch.ts -- --suite=llm",
    "test:e2e:local": "playwright test",
    "eval:narratives": "node --import tsx scripts/narrative-eval.ts",
    "test:mutate": "npx stryker run",
    "test:mutate:dry": "npx stryker run --dryRunOnly",
    "smoke:report": "node --import tsx scripts/smoke-test-report.ts",
    "smoke:thesis": "node --import tsx scripts/smoke-test-thesis.ts",
    "llm:probe": "node --import tsx scripts/llm-probe.ts",
    "llm:audit": "node --env-file=.env.local --import tsx scripts/audit-llm-quality.ts",
    "llm:degraded": "node --env-file=.env.local --import tsx scripts/list-degraded-reports.ts",
    "llm:regenerate": "node --env-file=.env.local --import tsx scripts/regenerate-report.ts"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@fontsource/noto-serif-sc": "^5.2.9",
    "@fontsource/source-serif-4": "^5.2.9",
    "@hugeicons/core-free-icons": "^4.0.0",
    "@hugeicons/react": "^1.1.5",
    "@neondatabase/serverless": "1.0.2",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "1.2.4",
    "@sentry/nextjs": "^10.42.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.3",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.35.0",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.2",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.11.0",
    "next": "^16.2.3",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^5.5.207",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "2.15.4",
    "resend": "^6.9.4",
    "stripe": "^23.1.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^10.0.1",
    "@next/bundle-analyzer": "^16.2.9",
    "@playwright/test": "^1.58.2",
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/typescript-checker": "^9.6.0",
    "@stryker-mutator/vitest-runner": "^9.6.0",
    "@tailwindcss/postcss": "^4.1.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv": "^17.3.1",
    "eslint": "^10.0.0",
    "postcss": "^8.5",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.9",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.0.18"
  }
}
