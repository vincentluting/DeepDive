# ============================================================
# Deep Dive — Environment Variables Reference
# Copy this file to .env.local and fill in your values.
# ============================================================

# === Database (required) ===
# Primary Neon Postgres connection string
POSTGRES_URL=postgresql://user:password@host/dbname?sslmode=require

# Alternative connection string names (Neon/Vercel integration auto-sets these)
# DATABASE_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=

# === AI Providers ===
# OpenAI — required for structured tasks (panel3, resume-parse, memory, coaching-summary)
OPENAI_API_KEY=sk-...

# Anthropic — optional; used for narrative tasks (panel1, panel2, integration, coaching)
# If unset, all Anthropic tasks fall back to GPT-4o-mini automatically
ANTHROPIC_API_KEY=sk-ant-...

# === Authentication (required) ===
# Secret for password hashing and session signing (min 32 random characters)
AUTH_SECRET=replace-with-at-least-32-random-characters

# Secret for admin bootstrap endpoint token (falls back to AUTH_SECRET if unset)
SESSION_SECRET=replace-with-at-least-32-random-characters

# === Admin (optional) ===
# Comma-separated list of admin email addresses (case-insensitive)
# Users with these emails are auto-promoted to admin on first login
ADMIN_EMAILS=admin@example.com,admin2@example.com

# === Analytics (optional) ===
# Comma-separated SHA-256 hashes of internal IP addresses to exclude from tracking
EXCLUDED_IP_HASHES=hash1,hash2

# === App (optional) ===
# Public URL used for OG metadata and share links
# Defaults to https://deepdive.careers if unset
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# === Cron (required for /api/cron/* endpoints) ===
# Bearer token validated by all cron endpoints. Set this in Vercel environment variables
# and configure the same value in your Vercel Cron job settings.
CRON_SECRET=replace-with-at-least-32-random-characters

# === AI Model Versions (optional, uses defaults if not set) ===
# Override to switch models without code changes
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# OPENAI_MODEL=gpt-4o-mini

# === AI Coach V2 rollout (optional) ===
# "shadow" computes and audits V2 routing without changing model instructions.
# "false" is the emergency rollback. Any other value enables percentage rollout.
# COACHING_V2_ENABLED=shadow
# COACHING_V2_ROLLOUT_PERCENT=0
# COACHING_KNOWLEDGE_VERSION_DATE=2026-06-10

# === Rate Limiting (optional, recommended for production) ===
# Upstash Redis for persistent rate limiting on high-cost LLM endpoints
# If unset, falls back to in-memory rate limiting (less effective on serverless)
# Get from https://upstash.com → Redis → your database
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxx...

# === Error Monitoring (optional, recommended for production) ===
# Sentry DSN for error tracking — get from https://sentry.io project settings
# If unset, Sentry is disabled (no errors are sent anywhere)
SENTRY_DSN=https://xxx@o123.ingest.sentry.io/456
# Also expose to client-side for browser error capture
NEXT_PUBLIC_SENTRY_DSN=https://xxx@o123.ingest.sentry.io/456

# Sentry auth token for source map upload (only needed in CI/build)
SENTRY_AUTH_TOKEN=sntrys_...

# Sentry org and project slugs (for source map upload)
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project

# === E2E Testing (optional) ===
# Route all LLM calls through Groq free tier for E2E tests (avoids OpenAI/Anthropic costs)
# E2E_USE_GROQ=true
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# === Database Debugging (optional) ===
# Set to 'true' to log slow queries (>500ms) in dev/test
# DB_SLOW_QUERY_LOG=true

# === Language Guard (emergency rollback only) ===
# Set to '1' to disable the report-generation language mismatch guard.
# The guard detects LLM output in a different language than the target locale
# (e.g., Chinese text leaking into an English report when user inputs are Chinese)
# and regenerates / sanitizes it. Disable only if the guard is causing production issues —
# see lib/report-generation/language-guard.ts.
# LANGUAGE_GUARD_DISABLED=1

# === OAuth (Google + Apple) ===
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Apple Sign In (requires Apple Developer account)
# APPLE_CLIENT_ID=com.your.service.id
# APPLE_TEAM_ID=YOUR_TEAM_ID
# APPLE_KEY_ID=YOUR_KEY_ID
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# === Email (Resend) ===
# Resend email service — transactional emails (welcome, password reset, reminders)
RESEND_API_KEY=re_...
# EMAIL_FROM_ADDRESS=Deep Dive <noreply@deepdive.app>

# === Payment (planned, not yet active) ===
# Stripe API key — placeholder for future payment integration
# STRIPE_SECRET_KEY=sk_...

# === Avatar CDN (Cloudflare R2 / Pages) ===
# When set, archetype avatars are served as .webp from this base URL.
# When unset, falls back to /public/12 avatar/*.png (46MB total — risks
# Vercel Hobby 100GB/mo bandwidth ceiling during thesis recruitment).
# Setup: docs/operations/avatar-cdn-setup.md
# NEXT_PUBLIC_AVATAR_CDN_BASE=https://cdn.example.com/avatars
# NEXT_PUBLIC_AVATAR_CDN_HOST=cdn.example.com

# NODE_ENV is set automatically by Next.js (development / production / test)
# Do not set this manually.
